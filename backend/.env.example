# ------------------------------------------------------------------
# Kanban backend - environment variables (copy to .env and adjust)
# ------------------------------------------------------------------

# --- PostgreSQL (Docker container, host port is random to avoid 5432) ---
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
POSTGRES_PORT=5433

# --- Redis (Docker container, host port is random to avoid 6379) ---
REDIS_PORT=6380

# --- API server ---
PORT=4000
API_PORT=4000

# Prisma connection string - host ports above
DATABASE_URL="postgresql://kanban:kanban@localhost:5433/kanban?schema=public"
REDIS_URL="redis://localhost:6380"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000,https://kanban-board-web-nine.vercel.app"

# --- Redis cache TTLs (seconds) ---
# Full board payload
REDIS_CACHE_TTL=60
# Per-user board lists (mine / shared)
REDIS_LIST_TTL=30